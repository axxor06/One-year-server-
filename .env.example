# Copy this file to server/.env and fill it in. NEVER commit server/.env.
PORT=5000
# The website address allowed to call this API (no trailing slash). Production: your deployed frontend URL.
CLIENT_ORIGIN=http://localhost:5173
# From resend.com -> API Keys
RESEND_API_KEY=your_resend_api_key_here
# Where Dhwani's messages are delivered (your private email)
GUESTBOOK_TO_EMAIL=you@example.com
# Resend's test sender works for testing; later you can verify your own domain
GUESTBOOK_FROM_EMAIL=onboarding@resend.dev
# ---- The automatic love letter to Dhwani: sent with the GMAIL API using OAuth 2.0 (free, no SMTP) ----
# From your Google Cloud project: APIs & Services -> Credentials -> your OAuth client.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Created for you by "npm run gmail:authorize" (it writes this line for you). Never type it into the website or commit it.
GOOGLE_REFRESH_TOKEN=your_refresh_token_from_gmail_authorize
# The Gmail address you authorize with (the letter is sent from it)
GMAIL_USER=your_gmail_address@gmail.com
# Dhwani's email address (server only; it is never sent to the browser)
HER_EMAIL=dhwanis_email_address@example.com
# Only used by "npm run gmail:authorize" on your own computer. Must match the redirect URI you add in Google Cloud exactly.
# GOOGLE_REDIRECT_URI=http://localhost:8123/oauth2callback
